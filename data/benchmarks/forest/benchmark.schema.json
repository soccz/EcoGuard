{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/soccz/EcoGuard/v0.5.0/data/benchmarks/forest/benchmark.schema.json",
  "title": "EcoGuard synthetic geospatial plumbing benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "classification",
    "purpose",
    "files",
    "grid",
    "observations",
    "masking",
    "prediction_rule",
    "tiling",
    "spatial_split",
    "reference",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "forest-geospatial-benchmark/1.0"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "classification": {"const": "synthetic_geospatial_plumbing_benchmark"},
    "purpose": {"type": "string", "minLength": 1},
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_pixels", "reference_mask"],
      "properties": {
        "scene_pixels": {"type": "string", "pattern": "^[^/\\\\]+\\.csv$"},
        "reference_mask": {"type": "string", "pattern": "^[^/\\\\]+\\.csv$"}
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "cols", "crs", "geotransform", "nodata_value", "pixel_origin"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1, "maximum": 1000},
        "cols": {"type": "integer", "minimum": 1, "maximum": 1000},
        "crs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "code", "name", "kind", "axis_unit"],
          "properties": {
            "authority": {"const": "EPSG"},
            "code": {"const": 32652},
            "name": {"const": "WGS 84 / UTM zone 52N"},
            "kind": {"const": "projected"},
            "axis_unit": {"const": "metre"}
          }
        },
        "geotransform": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/decimalString"}
        },
        "nodata_value": {"$ref": "#/$defs/decimalString"},
        "pixel_origin": {"const": "upper_left_corner"}
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "seasonality_policy"],
      "properties": {
        "before": {"$ref": "#/$defs/scene"},
        "after": {"$ref": "#/$defs/scene"},
        "seasonality_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "require_same_season_label",
            "maximum_day_of_year_delta",
            "minimum_elapsed_days",
            "maximum_elapsed_days",
            "timezone"
          ],
          "properties": {
            "require_same_season_label": {"const": true},
            "maximum_day_of_year_delta": {"type": "integer", "minimum": 1, "maximum": 183},
            "minimum_elapsed_days": {"type": "integer", "minimum": 1},
            "maximum_elapsed_days": {"type": "integer", "minimum": 1},
            "timezone": {"const": "UTC"}
          }
        }
      }
    },
    "masking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qa_clear_class", "qa_excluded_classes", "nodata_scope", "evaluation_scope"],
      "properties": {
        "qa_clear_class": {"const": "clear"},
        "qa_excluded_classes": {"const": ["cloud", "shadow"]},
        "nodata_scope": {"const": "any_required_band"},
        "evaluation_scope": {"const": "valid_holdout_pixels_only"}
      }
    },
    "prediction_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "forest_ndvi_min", "ndvi_decrease_min", "threshold_provenance"],
      "properties": {
        "kind": {"const": "fixed_ndvi_threshold"},
        "forest_ndvi_min": {"$ref": "#/$defs/decimalString"},
        "ndvi_decrease_min": {"$ref": "#/$defs/decimalString"},
        "threshold_provenance": {"type": "string", "minLength": 1}
      }
    },
    "tiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tile_height", "tile_width", "order", "edge_policy"],
      "properties": {
        "tile_height": {"type": "integer", "minimum": 1},
        "tile_width": {"type": "integer", "minimum": 1},
        "order": {"const": "row_major"},
        "edge_policy": {"const": "clip"}
      }
    },
    "spatial_split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "holdout_tile_ids", "reported_metrics_scope", "selection_provenance"],
      "properties": {
        "strategy": {"const": "deterministic_tile_holdout"},
        "holdout_tile_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^tile-r[0-9]{4}-c[0-9]{4}$"}
        },
        "reported_metrics_scope": {"const": "valid_holdout_pixels_only"},
        "selection_provenance": {"type": "string", "minLength": 1}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "creator", "created_at", "method", "license", "independent_ground_truth"],
      "properties": {
        "kind": {"const": "team_authored_synthetic_binary_mask"},
        "creator": {"type": "string", "minLength": 1},
        "created_at": {"$ref": "#/$defs/utcTimestamp"},
        "method": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "independent_ground_truth": {"const": false}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demonstrates", "does_not_demonstrate"],
      "properties": {
        "demonstrates": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "does_not_demonstrate": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
      }
    }
  },
  "$defs": {
    "decimalString": {
      "type": "string",
      "pattern": "^-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "acquired_at", "season_label", "sensor_family", "product_level", "source_kind"],
      "properties": {
        "scene_id": {"type": "string", "minLength": 1},
        "acquired_at": {"$ref": "#/$defs/utcTimestamp"},
        "season_label": {"type": "string", "minLength": 1},
        "sensor_family": {"type": "string", "minLength": 1},
        "product_level": {"type": "string", "minLength": 1},
        "source_kind": {"const": "team_authored_synthetic"}
      }
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
