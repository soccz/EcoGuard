{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/soccz/EcoGuard/main/schemas/artifact_manifest.schema.json",
  "title": "EcoGuard deterministic artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_version", "inputs", "outputs", "verification"],
  "properties": {
    "schema_version": {"const": "artifact-manifest/1.0"},
    "pipeline_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "inputs": {"$ref": "#/$defs/manifestEntries"},
    "outputs": {"$ref": "#/$defs/manifestEntries"},
    "verification": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "manifestEntries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
